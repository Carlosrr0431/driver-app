{
  "expo": {
    "name": "Profesional Conductor",
    "slug": "driver-app",
    "version": "1.0.43",
    "runtimeVersion": "1.0.43",
    "updates": {
      "url": "https://u.expo.dev/21599c2c-8f85-4d49-84d7-71202995c3e5",
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "com.remises.driverapp",
      "buildNumber": "40",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true,
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrar tu posición en el mapa y asignarte viajes cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Necesitamos tu ubicación en segundo plano, incluso con la app cerrada, para que la central vea tu posición en tiempo real mientras estás en línea o en un viaje.",
        "NSLocationAlwaysUsageDescription": "Necesitamos tu ubicación siempre activa para que la central actualice tu pin en tiempo real con la app en segundo plano.",
        "NSMicrophoneUsageDescription": "Necesitamos acceso al micrófono para el asistente de voz.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para actualizar tu foto de perfil.",
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para tomar tu foto de perfil.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "audio"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.remises.driverapp",
      "versionCode": 47,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/icon.png",
            "imageWidth": 200,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
          },
          "ios": {
            "image": "./assets/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true
          },
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Necesitamos tu ubicación para mostrar tu posición en el mapa y asignarte viajes cercanos.",
          "locationAlwaysAndWhenInUsePermission": "Necesitamos tu ubicación en segundo plano, incluso con la app cerrada, para que la central vea tu posición en tiempo real mientras estás en línea o en un viaje.",
          "locationAlwaysPermission": "Necesitamos tu ubicación siempre activa para que la central actualice tu pin en tiempo real con la app en segundo plano.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon-monochrome.png",
          "color": "#282e69",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/withLocationForegroundNotification.js",
      "@maplibre/maplibre-react-native",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-font",
      "expo-updates",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tus fotos para actualizar tu foto de perfil.",
          "cameraPermission": "Necesitamos acceso a la cámara para tomar tu foto de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "21599c2c-8f85-4d49-84d7-71202995c3e5"
      }
    },
    "owner": "carlosrr"
  }
}
